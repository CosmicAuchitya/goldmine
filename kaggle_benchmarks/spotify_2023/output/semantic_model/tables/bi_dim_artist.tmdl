table bi_dim_artist
	lineageTag: dim-bi_dim_artist-lineage

	column fact_surrogate_id
		dataType: int64
		summarizeBy: none
		sourceColumn: fact_surrogate_id
		lineageTag: col-bi_dim_artist-fact_surrogate_id
		formatString: #,0

	column artist(s)_name
		dataType: string
		summarizeBy: none
		sourceColumn: artist(s)_name
		lineageTag: col-bi_dim_artist-artist(s)_name

	column artist_count
		dataType: int64
		summarizeBy: sum
		sourceColumn: artist_count
		lineageTag: col-bi_dim_artist-artist_count
		formatString: #,0

	partition bi_dim_artist = m
		mode: import
		source = 
			let
				Source = Csv.Document(File.Contents("bi_dim_artist.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.None])
			in
				Source
