      "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
      "title": "Risk Exposure & Capital Drag across Customer type",
      "width": 600,
      "height": 280,
      "data": {
        "values": [
          {
            "segment": "Member",
            "volume": 501,
            "target_events": 98,
            "adverse_rate_pct": 19.56,
            "capital_drag": 34549.011000000006
