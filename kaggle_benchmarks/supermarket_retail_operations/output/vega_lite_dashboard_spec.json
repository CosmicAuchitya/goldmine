            "capital_drag": 25759.9755
          }
        ]
      },
      "mark": {
        "type": "bar",
        "cornerRadiusEnd": 4
      },
      "encoding": {
        "y": {
          "field": "segment",
          "type": "nominal",
          "sort": "-x",
          "title": "Customer type"
        },
        "x": {
          "field": "adverse_rate_pct",
          "type": "quantitative",
          "title": "Adverse Failure Rate (%)"
        },
        "color": {
          "field": "adverse_rate_pct",
          "type": "quantitative",
          "scale": {
            "scheme": "redyellowblue",
            "reverse": true
          },
          "legend": {
            "title": "Risk %"
          }
        },
        "tooltip": [
          {
            "field": "segment",
            "type": "nominal",
            "title": "Segment"
          },
          {
            "field": "volume",
            "type": "quantitative",
            "title": "Volume",
            "format": ","
          },
          {
            "field": "target_events",
            "type": "quantitative",
            "title": "Adverse Events",
            "format": ","
          },
          {
            "field": "adverse_rate_pct",
            "type": "quantitative",
            "title": "Failure Rate (%)",
            "format": ".2f"
          },
          {
            "field": "capital_drag",
