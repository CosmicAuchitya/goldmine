  "specs": {
    "primary_dimension_risk": {
      "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
      "title": "Risk Exposure & Capital Drag across poutcome",
      "width": 600,
      "height": 280,
      "data": {
        "values": [
          {
            "segment": "success",
            "volume": 1373,
            "target_events": 894,
            "adverse_rate_pct": 65.11,
            "capital_drag": 0.0
          },
          {
            "segment": "failure",
            "volume": 4252,
            "target_events": 605,
            "adverse_rate_pct": 14.23,
            "capital_drag": 0.0
          },
          {
            "segment": "nonexistent",
            "volume": 35563,
            "target_events": 3141,
            "adverse_rate_pct": 8.83,
            "capital_drag": 0.0
          }
        ]
      },
      "mark": {
        "type": "bar",
        "cornerRadiusEnd": 4
      },
      "encoding": {
        "y": {
          "field": "segment",
          "type": "nominal",
          "sort": "-x",
          "title": "poutcome"
        },
        "x": {
          "field": "adverse_rate_pct",
          "type": "quantitative",
          "title": "Adverse Failure Rate (%)"
        },
        "color": {
          "field": "adverse_rate_pct",
          "type": "quantitative",
          "scale": {
            "scheme": "redyellowblue",
            "reverse": true
          },
          "legend": {
            "title": "Risk %"
          }
        },
        "tooltip": [
          {
            "field": "segment",
            "type": "nominal",
            "title": "Segment"
          },
          {
            "field": "volume",
            "type": "quantitative",
            "title": "Volume",
            "format": ","
          },
          {
            "field": "target_events",
            "type": "quantitative",
            "title": "Adverse Events",
            "format": ","
          },
          {
            "field": "adverse_rate_pct",
            "type": "quantitative",
            "title": "Failure Rate (%)",
            "format": ".2f"
          },
          {
            "field": "capital_drag",
            "type": "quantitative",
            "title": "Capital Drag ($)",
            "format": "$,.2f"
          }
        ]
      }
    },
