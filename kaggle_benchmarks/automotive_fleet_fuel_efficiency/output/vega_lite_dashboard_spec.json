            "tooltip": [
              {
                "field": "quantile_tier",
                "type": "nominal",
                "title": "Stratum"
              },
              {
                "field": "volume",
                "type": "quantitative",
                "title": "Monitored Volume",
                "format": ","
              },
              {
                "field": "adverse_events",
                "type": "quantitative",
                "title": "Adverse Events",
                "format": ","
              },
              {
                "field": "failure_rate_pct",
                "type": "quantitative",
                "title": "Failure Rate %",
                "format": ".2f"
