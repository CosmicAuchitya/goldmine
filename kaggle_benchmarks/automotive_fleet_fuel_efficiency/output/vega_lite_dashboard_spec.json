{
  "dataset_name": "automotive_fleet_fuel_efficiency",
  "engine_version": "V4.5",
  "specs": {
    "primary_dimension_risk": {
      "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
      "title": "Risk Exposure & Capital Drag across origin",
      "width": 600,
      "height": 280,
      "data": {
        "values": [
          {
            "segment": "usa",
            "volume": 249,
            "target_events": 147,
            "adverse_rate_pct": 59.04,
            "capital_drag": 0.0
          },
          {
            "segment": "europe",
            "volume": 70,
            "target_events": 8,
            "adverse_rate_pct": 11.43,
            "capital_drag": 0.0
          },
          {
            "segment": "japan",
            "volume": 79,
            "target_events": 5,
            "adverse_rate_pct": 6.33,
            "capital_drag": 0.0
          }
        ]
      },
      "mark": {
        "type": "bar",
        "cornerRadiusEnd": 4
      },
      "encoding": {
        "y": {
          "field": "segment",
          "type": "nominal",
          "sort": "-x",
          "title": "origin"
        },
        "x": {
          "field": "adverse_rate_pct",
          "type": "quantitative",
          "title": "Adverse Failure Rate (%)"
        },
        "color": {
          "field": "adverse_rate_pct",
          "type": "quantitative",
          "scale": {
            "scheme": "redyellowblue",
            "reverse": true
          },
          "legend": {
            "title": "Risk %"
          }
        },
        "tooltip": [
          {
            "field": "segment",
            "type": "nominal",
            "title": "Segment"
          },
          {
            "field": "volume",
            "type": "quantitative",
            "title": "Volume",
            "format": ","
          },
          {
            "field": "target_events",
            "type": "quantitative",
            "title": "Adverse Events",
            "format": ","
          },
          {
            "field": "adverse_rate_pct",
            "type": "quantitative",
            "title": "Failure Rate (%)",
            "format": ".2f"
          },
          {
            "field": "capital_drag",
            "type": "quantitative",
            "title": "Capital Drag ($)",
            "format": "$,.2f"
          }
        ]
      }
    },
    "threshold_cliff": {
