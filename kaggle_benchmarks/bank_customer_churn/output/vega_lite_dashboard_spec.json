              "title": "Quantile Tier (Num Of Products)"
            },
            "y": {
              "field": "failure_rate_pct",
              "type": "quantitative",
              "title": "Failure Rate (%)"
            }
          }
        },
        {
          "mark": {
            "type": "line",
            "point": {
              "size": 80,
              "filled": true
            },
            "color": "#e63946",
            "strokeWidth": 3
