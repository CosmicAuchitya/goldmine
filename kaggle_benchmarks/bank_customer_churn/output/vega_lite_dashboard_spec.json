  "specs": {
    "primary_dimension_risk": {
      "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
      "title": "Risk Exposure & Capital Drag across Geography",
      "width": 600,
      "height": 280,
      "data": {
        "values": [
          {
            "segment": "Germany",
            "volume": 2509,
            "target_events": 814,
            "adverse_rate_pct": 32.44,
            "capital_drag": 80100763.57
          },
          {
            "segment": "Spain",
            "volume": 2477,
            "target_events": 413,
            "adverse_rate_pct": 16.67,
            "capital_drag": 42799006.14
          },
          {
            "segment": "France",
            "volume": 5014,
            "target_events": 810,
            "adverse_rate_pct": 16.15,
            "capital_drag": 83785815.42
          }
        ]
      },
      "mark": {
        "type": "bar",
        "cornerRadiusEnd": 4
      },
      "encoding": {
        "y": {
          "field": "segment",
          "type": "nominal",
          "sort": "-x",
          "title": "Geography"
        },
        "x": {
          "field": "adverse_rate_pct",
          "type": "quantitative",
          "title": "Adverse Failure Rate (%)"
        },
        "color": {
          "field": "adverse_rate_pct",
          "type": "quantitative",
          "scale": {
            "scheme": "redyellowblue",
            "reverse": true
          },
          "legend": {
            "title": "Risk %"
          }
        },
        "tooltip": [
          {
            "field": "segment",
            "type": "nominal",
            "title": "Segment"
          },
          {
            "field": "volume",
            "type": "quantitative",
            "title": "Volume",
            "format": ","
          },
          {
            "field": "target_events",
            "type": "quantitative",
            "title": "Adverse Events",
            "format": ","
          },
          {
            "field": "adverse_rate_pct",
            "type": "quantitative",
            "title": "Failure Rate (%)",
            "format": ".2f"
          },
          {
            "field": "capital_drag",
            "type": "quantitative",
            "title": "Capital Drag ($)",
            "format": "$,.2f"
          }
        ]
      }
    },
    "threshold_cliff": {
      "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
