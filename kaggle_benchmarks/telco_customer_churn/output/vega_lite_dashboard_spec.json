            "format": ","
          },
          {
            "field": "target_events",
            "type": "quantitative",
            "title": "Adverse Events",
            "format": ","
          },
          {
            "field": "adverse_rate_pct",
            "type": "quantitative",
            "title": "Failure Rate (%)",
