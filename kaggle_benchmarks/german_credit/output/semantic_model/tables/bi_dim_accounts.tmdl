table bi_dim_accounts
	lineageTag: dim-bi_dim_accounts-lineage

	column Saving accounts
		dataType: string
		summarizeBy: none
		sourceColumn: Saving accounts
		lineageTag: col-bi_dim_accounts-Saving accounts

	column Checking account
		dataType: string
		summarizeBy: none
