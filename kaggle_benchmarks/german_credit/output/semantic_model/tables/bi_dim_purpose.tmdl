table bi_dim_purpose
	lineageTag: dim-bi_dim_purpose-lineage

	column Purpose
		dataType: string
		summarizeBy: none
		sourceColumn: Purpose
		lineageTag: col-bi_dim_purpose-Purpose

	column Duration
		dataType: int64
		summarizeBy: sum
		sourceColumn: Duration
		lineageTag: col-bi_dim_purpose-Duration
		formatString: #,0

	column Credit amount
		dataType: int64
		summarizeBy: sum
		sourceColumn: Credit amount
		lineageTag: col-bi_dim_purpose-Credit amount
		formatString: #,0

	partition bi_dim_purpose = m
		mode: import
		source = 
			let
				Source = Csv.Document(File.Contents("bi_dim_purpose.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.None])
			in
				Source
