table bi_dim_demographics
	lineageTag: dim-bi_dim_demographics-lineage

	column Age
		dataType: int64
		summarizeBy: sum
		sourceColumn: Age
		lineageTag: col-bi_dim_demographics-Age
		formatString: #,0

	column Sex
		dataType: string
		summarizeBy: none
		sourceColumn: Sex
		lineageTag: col-bi_dim_demographics-Sex

	column Job
		dataType: int64
		summarizeBy: sum
		sourceColumn: Job
		lineageTag: col-bi_dim_demographics-Job
		formatString: #,0

	partition bi_dim_demographics = m
		mode: import
		source = 
			let
				Source = Csv.Document(File.Contents("bi_dim_demographics.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.None])
			in
				Source
