table bi_ready_fact
	lineageTag: fact-bi-ready-fact-lineage

	measure 'Total Volume' = COUNTROWS('bi_ready_fact')
		formatString: #,0
		lineageTag: m-total-volume
		annotation CertifiedMetric = "Physical Record Count: 53,940"

	measure 'Target Events' = CALCULATE(COUNTROWS('bi_ready_fact'), 'bi_ready_fact'[cut] IN {"Good", "Fair"})
		formatString: #,0
		lineageTag: m-target-events
		annotation CertifiedMetric = "Target Adverse Count: 6,516"

	measure 'Adverse Event Rate %' = DIVIDE([Target Events], [Total Volume], 0)
		formatString: 0.00%
		lineageTag: m-adverse-rate

	measure 'System Reliability %' = 1 - [Adverse Event Rate %]
		formatString: 0.00%
		lineageTag: m-reliability-rate

	measure 'Total Adverse Capital Drag ($)' = CALCULATE(SUM('bi_ready_fact'[price]), 'bi_ready_fact'[cut] IN {"Good", "Fair"})
		formatString: $#,0.00
		lineageTag: m-adverse-capital-drag
		annotation CertifiedMetric = "Audited Drag: $26,292,609.00"

	measure 'Total Portfolio Volume ($)' = SUM('bi_ready_fact'[price])
		formatString: $#,0.00
		lineageTag: m-total-portfolio-volume
		annotation CertifiedMetric = "Total Ledger Volume: $212,135,217.00"

	measure 'Avg Adverse Friction Impact ($)' = DIVIDE([Total Adverse Capital Drag ($)], [Target Events], 0)
		formatString: $#,0.00
		lineageTag: m-avg-adverse-friction

	column carat
		dataType: double
		summarizeBy: average
		sourceColumn: carat
		lineageTag: col-fact-carat
		formatString: 0.00

	column cut
		dataType: string
		summarizeBy: none
		sourceColumn: cut
		lineageTag: col-fact-cut

	column color
		dataType: string
		summarizeBy: none
		sourceColumn: color
		lineageTag: col-fact-color

	column clarity
		dataType: string
		summarizeBy: none
		sourceColumn: clarity
		lineageTag: col-fact-clarity

	column depth
		dataType: double
		summarizeBy: average
		sourceColumn: depth
		lineageTag: col-fact-depth
		formatString: 0.00

	column table
		dataType: double
		summarizeBy: average
		sourceColumn: table
		lineageTag: col-fact-table
		formatString: 0.00

	column price
		dataType: int64
		summarizeBy: sum
		sourceColumn: price
		lineageTag: col-fact-price
		formatString: #,0

	column x
		dataType: double
		summarizeBy: average
		sourceColumn: x
		lineageTag: col-fact-x
		formatString: 0.00

	column y
		dataType: double
		summarizeBy: average
		sourceColumn: y
		lineageTag: col-fact-y
		formatString: 0.00

	column z
		dataType: double
		summarizeBy: average
		sourceColumn: z
		lineageTag: col-fact-z
		formatString: 0.00

	column fact_surrogate_id
		dataType: string
		summarizeBy: none
		sourceColumn: fact_surrogate_id
		lineageTag: col-fact-fact_surrogate_id

	partition bi_ready_fact = m
		mode: import
		source = 
			let
				Source = Parquet.Document(File.Contents("bi_ready_fact.parquet"))
			in
				Source
