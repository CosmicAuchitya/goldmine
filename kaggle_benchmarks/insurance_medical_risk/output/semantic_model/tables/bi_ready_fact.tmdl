table bi_ready_fact
	lineageTag: fact-bi-ready-fact-lineage

	measure 'Total Volume' = COUNTROWS('bi_ready_fact')
		formatString: #,0
		lineageTag: m-total-volume
		annotation CertifiedMetric = "Physical Record Count: 1,338"

	measure 'Target Events' = CALCULATE(COUNTROWS('bi_ready_fact'), 'bi_ready_fact'[smoker] = "yes")
		formatString: #,0
		lineageTag: m-target-events
		annotation CertifiedMetric = "Target Adverse Count: 274"

	measure 'Adverse Event Rate %' = DIVIDE([Target Events], [Total Volume], 0)
		formatString: 0.00%
		lineageTag: m-adverse-rate

	measure 'System Reliability %' = 1 - [Adverse Event Rate %]
		formatString: 0.00%
		lineageTag: m-reliability-rate

	measure 'Total Adverse Capital Drag ($)' = CALCULATE(SUM('bi_ready_fact'[charges]), 'bi_ready_fact'[smoker] = "yes")
		formatString: $#,0.00
		lineageTag: m-adverse-capital-drag
		annotation CertifiedMetric = "Audited Drag: $8,781,763.52"

	measure 'Total Portfolio Volume ($)' = SUM('bi_ready_fact'[charges])
		formatString: $#,0.00
		lineageTag: m-total-portfolio-volume
		annotation CertifiedMetric = "Total Ledger Volume: $17,755,824.99"

	measure 'Avg Adverse Friction Impact ($)' = DIVIDE([Total Adverse Capital Drag ($)], [Target Events], 0)
		formatString: $#,0.00
		lineageTag: m-avg-adverse-friction

	column age
		dataType: int64
		summarizeBy: sum
		sourceColumn: age
		lineageTag: col-fact-age
		formatString: #,0

	column sex
		dataType: string
		summarizeBy: none
		sourceColumn: sex
		lineageTag: col-fact-sex

	column bmi
		dataType: double
		summarizeBy: average
		sourceColumn: bmi
		lineageTag: col-fact-bmi
		formatString: 0.00

	column children
		dataType: int64
		summarizeBy: sum
		sourceColumn: children
		lineageTag: col-fact-children
		formatString: #,0

	column smoker
		dataType: string
		summarizeBy: none
		sourceColumn: smoker
		lineageTag: col-fact-smoker

	column region
		dataType: string
		summarizeBy: none
		sourceColumn: region
		lineageTag: col-fact-region

	column charges
		dataType: double
		summarizeBy: sum
		sourceColumn: charges
		lineageTag: col-fact-charges
		formatString: $#,0.00

	column fact_surrogate_id
		dataType: string
		summarizeBy: none
		sourceColumn: fact_surrogate_id
		lineageTag: col-fact-fact_surrogate_id

	partition bi_ready_fact = m
		mode: import
		source = 
			let
				Source = Parquet.Document(File.Contents("bi_ready_fact.parquet"))
			in
				Source
