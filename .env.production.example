# =============================================================================
# DATAX-RAY PRODUCTION ENVIRONMENT TEMPLATE (.env.production)
# Copy to `.env.production` on your server and fill real secrets before launch.
# Generate strong 64-char hex secrets with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# =============================================================================

# --- Core Domain & CORS ---
DATAXRAY_DOMAIN=app.yourdomain.com
DATAXRAY_CORS_ORIGINS=https://app.yourdomain.com

# --- Authentication & Security (MANDATORY IN PRODUCTION) ---
DATAXRAY_REQUIRE_AUTH=true
DATAXRAY_JWT_SECRET=REPLACE_WITH_64_CHAR_HEX_SECRET
DATAXRAY_API_KEY=REPLACE_WITH_ADMIN_64_CHAR_HEX_KEY
DATAXRAY_ALLOW_AI_CODEGEN=false
DATAXRAY_TRUST_PROXY_HEADERS=true
DATAXRAY_RATE_LIMIT_RPM=120

# --- Subscription Billing & Usage Quotas (Stripe Global + Razorpay India) ---
DATAXRAY_ENFORCE_BILLING_QUOTAS=true

# Stripe (Global USD / EUR / GBP cards)
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_STARTER=price_...
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_ENTERPRISE=price_...

# Razorpay (India INR / UPI / Cards)
RAZORPAY_KEY_ID=rzp_live_...
RAZORPAY_KEY_SECRET=REPLACE_WITH_RAZORPAY_SECRET
RAZORPAY_WEBHOOK_SECRET=REPLACE_WITH_RAZORPAY_WEBHOOK_SECRET

# --- Gemini LLM Pool (Optional: Deterministic DuckDB engine works even without LLM) ---
GEMINI_API_KEY=REPLACE_WITH_GEMINI_KEY
GEMINI_API_KEY_SECONDARY=

# --- Automated Morning Digest & Alerts (Optional) ---
DATAXRAY_SMTP_HOST=smtp.gmail.com
DATAXRAY_SMTP_PORT=587
DATAXRAY_SMTP_USER=alerts@yourdomain.com
DATAXRAY_SMTP_PASS=REPLACE_WITH_APP_PASSWORD
DATAXRAY_SMTP_FROM=DataX-Ray Alerts <alerts@yourdomain.com>

# WhatsApp Cloud API (Optional)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

# --- Phase B: 1-Click OAuth 2.0 Connectors & Encrypted Token Vault (Optional) ---
# AES-256-GCM master vault key for encrypting OAuth tokens at rest (64-char hex)
DATAXRAY_VAULT_KEY=REPLACE_WITH_64_CHAR_HEX_VAULT_KEY

# Shopify Admin OAuth App
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# QuickBooks Online OAuth App
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=

# Stripe Connect OAuth (uses STRIPE_SECRET_KEY above for token exchange)
STRIPE_CONNECT_CLIENT_ID=

# Zoho Books OAuth App (India/US/EU/AU)
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=

# --- Phase C: Horizontal Cloud Scale (Optional — leave unset for zero-cost local SQLite/disk) ---
# Unified PostgreSQL 16 connection pool URL (RDS / Neon / Supabase / Docker Postgres)
DATABASE_URL=
POSTGRES_DB=dataxray
POSTGRES_USER=dataxray
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_PG_PASSWORD
DATAXRAY_PG_POOL_MAX=20

# Redis 7 URL for RQ multi-worker queues (high/default/bulk), Pub/Sub SSE & shared rate limiting
REDIS_URL=

# Cloud Object Storage (AWS S3, Cloudflare R2, or MinIO)
DATAXRAY_S3_BUCKET=
DATAXRAY_S3_PREFIX=dataxray
DATAXRAY_S3_ENDPOINT_URL=
DATAXRAY_S3_REGION=auto
DATAXRAY_S3_SSE=AES256
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
