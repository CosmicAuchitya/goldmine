# =============================================================================
# DATAX-RAY AUTONOMOUS DECISION ENGINE — PRODUCTION ENVIRONMENT CONFIGURATION
# Copy this file to .env and fill in strong secrets before global launch.
# =============================================================================

# 1. Multi-Tenant Authentication & Security (P0 Hardened)
# Strong random secret for signing Tenant JWT Bearer tokens (openssl rand -hex 32)
DATAXRAY_JWT_SECRET=
# Set to 'true' in production to require Tenant JWT or Admin API Key on all private routes
DATAXRAY_REQUIRE_AUTH=true
# Optional Admin API Key for enterprise automation / CI pipelines
DATAXRAY_API_KEY=

# 2. Cloud Sandbox & Abuse Protection
# Keep 'false' in multi-tenant cloud (routes all jobs through 100%-verified deterministic DAG)
DATAXRAY_ALLOW_AI_CODEGEN=false
# Comma-separated allowed frontend origins (e.g. https://app.dataxray.ai)
DATAXRAY_CORS_ORIGINS=http://localhost:8000
# Per-IP sliding-window request limit per minute
DATAXRAY_RATE_LIMIT_RPM=120

# 3. Gemini LLM API Key Pool (Optional for deterministic mode; required for LLM Q&A)
GEMINI_API_KEY=
GEMINI_API_KEYS=

# 4. Default Regional & Currency Profile (US | IN | EU | GB)
DEFAULT_REGION_PROFILE=US

# 5. Server Runtime Port
UVICORN_PORT=8000
