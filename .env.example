# =============================================================================
# DATAX-RAY AUTONOMOUS DECISION ENGINE — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and fill in values before production launch.
# =============================================================================

# 1. Gemini LLM API Key Pool (Optional for deterministic/DAG mode; required for AI mode & LLM Q&A)
GEMINI_API_KEY=
# Optional comma-separated multi-key pool for higher RPM throughput:
GEMINI_API_KEYS=

# 2. Enterprise API Key Guard (Optional: when set, all /api/v1/* routes require X-API-Key or Bearer token)
DATAXRAY_API_KEY=

# 3. Default Regional & Currency Profile (US | IN | EU | UK | JP | AE | SG | AU | BR)
DEFAULT_REGION_PROFILE=US

# 4. Server Runtime Port
UVICORN_PORT=8000
